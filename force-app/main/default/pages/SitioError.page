  (static resource PortalReact) para conservar la identidad visual. Sin detalles técnicos.
-->
<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" title="Donaciones · Mexico Dreamin">
    <html lang="es">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1" />
            <title>Página no disponible · Ruta a Mexico Dreamin</title>
            <link rel="stylesheet" href="{!URLFOR($Resource.PortalReact, 'assets/index.css')}" />
        </head>
        <body>
            <header class="header">
                <div class="contenedor header__barra">
                    <a class="marca" href="/">
                        <span class="marca__texto">Ruta a Mexico Dreamin<small>SF Vibe Lab · UADY</small></span>
                    </a>
                </div>
            </header>
            <main class="estado">
                <div class="contenedor">
                    <div class="estado__tarjeta">
