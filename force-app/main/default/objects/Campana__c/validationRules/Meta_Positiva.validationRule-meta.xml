<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Meta_Positiva</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISBLANK(Meta__c), Meta__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Meta__c</errorDisplayField>
    <errorMessage>La meta debe ser mayor a cero.</errorMessage>
</ValidationRule>
