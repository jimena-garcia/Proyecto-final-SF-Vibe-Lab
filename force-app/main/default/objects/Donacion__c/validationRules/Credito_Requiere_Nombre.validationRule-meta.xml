<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Credito_Requiere_Nombre</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Modalidad__c, &quot;Credito&quot;), ISBLANK(Nombre__c))</errorConditionFormula>
    <errorDisplayField>Nombre__c</errorDisplayField>
    <errorMessage>Para aparecer como donante se requiere el nombre.</errorMessage>
</ValidationRule>
