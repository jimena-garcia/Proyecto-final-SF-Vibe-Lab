<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Monto_Positivo</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Monto__c)), Monto__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Monto__c</errorDisplayField>
    <errorMessage>El monto debe ser mayor a cero.</errorMessage>
</ValidationRule>
