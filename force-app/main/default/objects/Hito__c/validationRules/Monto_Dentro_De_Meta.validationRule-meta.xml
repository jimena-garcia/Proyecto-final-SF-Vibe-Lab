<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Monto_Dentro_De_Meta</fullName>
    <active>true</active>
    <errorConditionFormula>OR(Monto__c &lt;= 0, Monto__c &gt; Campana__r.Meta__c)</errorConditionFormula>
    <errorDisplayField>Monto__c</errorDisplayField>
    <errorMessage>El monto del hito debe ser mayor a cero y no puede superar la meta de la campaña.</errorMessage>
</ValidationRule>
